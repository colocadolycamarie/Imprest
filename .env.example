# Postgres connection string used by the API server and by drizzle-kit.
DATABASE_URL=postgres://user:password@localhost:5432/imprest

# API server port (defaults to 5000 if unset).
PORT=5000

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin allowed to make credentialed requests to the API.
CORS_ORIGIN=http://localhost:5173

# Where uploaded receipts are stored on disk (defaults to ./uploads).
UPLOAD_DIR=./uploads
